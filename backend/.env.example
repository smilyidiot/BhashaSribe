# Copy to .env and adjust as needed.

# SQLite by default so the backend runs with zero extra setup.
# For the real deployment, point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://bhashascribe:bhashascribe@localhost:5432/bhashascribe
DATABASE_URL=sqlite:///./bhashascribe.db

# faster-whisper settings. "small" is a reasonable CPU speed/accuracy tradeoff.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
